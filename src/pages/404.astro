---
import Layout from "../layouts/Layout.astro";
import PageBackdrop from "../components/PageBackdrop.astro";
import { Image } from "astro:assets";
import grooveFacts from "../assets/groove-facts.jpg";

const home = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<Layout title="Page not found — Guacamayo" description="That page doesn't exist.">
	<PageBackdrop>
		<div class="flex min-h-dvh flex-col">
			<div class="flex flex-1 flex-col items-center justify-center gap-4 px-6 pt-20 text-center">
				<p class="font-display-alt text-6xl font-black text-paper-2">404</p>
				<p class="max-w-sm text-sm text-paper-2/80">
					That page wandered off. Here's the secret recipe while you look for it:
				</p>
				<Image
					src={grooveFacts}
					alt='"Guaca Mayo" novelty label art, styled like a nutrition-facts panel, listing the band as ingredients'
					widths={[220, 320]}
					sizes="260px"
					class="w-56 rotate-[-2deg] rounded-xl shadow-2xl sm:w-64"
				/>
				<a
					href={home}
					class="mt-2 inline-flex min-h-11 items-center rounded-full bg-gold px-5 py-2.5 font-mono text-xs tracking-wide text-ink uppercase"
					>Back to Guacamayo</a
				>
			</div>
		</div>
	</PageBackdrop>
</Layout>
