---
// Bio copy is a second draft — longer than the first pass, but still built
// only from verified facts (lineup, instruments, genre, city, the real
// songs the band covers per Doug's own corrections, and setting language
// already established elsewhere on the site — outdoor stages, a club
// stage, the "beachside set" video caption). No invented formation story,
// influences, or history. Still not the band's own voice — replace before
// launch; see docs/TODO.md.
const members = [
	{ name: "Doug Rosenberg", instrument: "Saxophone" },
	{ name: "Jack Zará", instrument: "Bass" },
	{ name: "Manuel Reyes", instrument: "Guitar" },
	{ name: "Javier Saume Mazzei", instrument: "Drums" },
];
---

<section id="about" class="relative px-8 py-24 sm:px-16 sm:py-32">
	<div class="absolute inset-0 -z-10 bg-ink/55 backdrop-blur-md section-glass-fade"></div>
	<div class="absolute inset-0 -z-10 bg-gold/25 section-glass-fade"></div>
	<h2 class="font-display-alt text-xl font-black">About</h2>
	<p class="mt-4 max-w-lg text-sm leading-relaxed text-paper-2/80">
		Guacamayo plays funky Latin groove out of Chicago — a horn-forward
		four-piece built on saxophone, guitar, bass, and drums, locking into a
		pocket tight enough for a club stage and loose enough for a packed
		dance floor. Live sets mix originals with the band's own take on a
		handful of standards it's made a habit of stretching out and funking
		up — Herbie Hancock's "Cantaloupe Island," Stevie Wonder's "Isn't She
		Lovely" — the kind of songs that reward a band willing to let the
		groove run long. Whether it's an outdoor stage, a beachside set, or a
		late-night club show, the goal doesn't change: four players, one
		groove, and a room that isn't ready to stop dancing.
	</p>

	<ul class="mt-8 grid max-w-lg grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
		{
			members.map((member) => (
				<li>
					<p class="font-semibold text-paper-2">{member.name}</p>
					<p class="font-mono text-xs tracking-wide text-orange uppercase">
						{member.instrument}
					</p>
				</li>
			))
		}
	</ul>
</section>
