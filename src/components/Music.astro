---
// Chained-playlist embed (?playlist=id2,id3,...) instead of a saved YouTube
// playlist — no channel login needed to set up, native YouTube next/prev +
// autoplay chaining. If Javier later makes a real saved playlist on the
// channel, swap `src` for `https://www.youtube.com/embed/videoseries?list=PLxxxx`
// and nothing else needs to change.
const shortIds = [
	"KGx6Zwm1Dsg",
	"-4trKHWWudA",
	"3W4F4VmI0tQ",
	"pUUw3akwihE",
	"Flnw1t7SzDI",
	"6cZyB4y2flA",
];
const [first, ...rest] = shortIds;
const src = `https://www.youtube.com/embed/${first}?playlist=${rest.join(",")}`;
---

<section id="music" class="bg-ink px-8 py-16 sm:px-16">
	<h2 class="font-display-alt text-xl font-black">Music</h2>
	<p class="mt-2 max-w-md text-sm text-paper-2/80">
		Live clips and the band's own reel, chained as one playlist — next video queues
		automatically.
	</p>
	<div class="mt-8 aspect-[9/16] w-full max-w-[300px] overflow-hidden rounded-lg bg-black">
		<iframe
			class="h-full w-full"
			src={src}
			title="Guacamayo video playlist"
			loading="lazy"
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
			allowfullscreen
		></iframe>
	</div>
</section>
